rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getRole() {
      // Because this project is on the Free Spark Plan, we cannot use Cloud Functions to set Custom Claims.
      // Therefore, we MUST read the role directly from the users collection.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrPusat() {
      return isAuthenticated() && (
        getRole() == 'ADMIN' || 
        getRole() == 'PUSAT' || 
        getRole() == 'STAFF_PUSAT'
      );
    }
    
    function isStaffBranch() {
      return isAuthenticated() && getRole() == 'STAFF_BRANCH';
    }
    
    function isBranchContext(branchId) {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.branchId == branchId;
    }

    // Metadata & Initial System Bootstrapping
    match /system_metadata/{doc} {
      allow read: if true;
      allow write: if isAdminOrPusat();
    }

    // Master Catalog Data (Produk, Brand, Kategori Mesin, Cabang) - Publik Read untuk E-Katalog
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdminOrPusat();
    }

    match /brands/{doc} {
      allow read: if true;
      allow write: if isAdminOrPusat();
    }

    match /machine_categories/{doc} {
      allow read: if true;
      allow write: if isAdminOrPusat();
    }

    match /branches/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrPusat();
    }

    match /branch_secrets/{doc} {
      allow read, write: if isAdminOrPusat();
    }

    // Manajemen Pengguna & Profil
    match /users/{userId} {
      // User hanya bisa baca profilnya sendiri (berdasarkan UID atau Email), Admin/Pusat bisa akses semua
      allow read: if isAuthenticated() && (isAdminOrPusat() || request.auth.uid == userId || request.auth.token.email == resource.data.email);
      // Migration rule: Allow user to create their own document at their UID, and Admin to create any
      allow create: if isAdminOrPusat() || (isAuthenticated() && request.auth.uid == userId && request.resource.data.email == request.auth.token.email && (request.resource.data.role == 'STAFF_BRANCH' || request.auth.token.email == 'admin@perusahaan.com'));
      // Admin/Pusat can update anyone. User can update themselves but cannot elevate privileges or change branch assignment.
      allow update: if isAuthenticated() && (isAdminOrPusat() || (request.auth.uid == userId && request.resource.data.role == resource.data.role && request.resource.data.branchId == resource.data.branchId && request.resource.data.status == resource.data.status));
      allow delete: if isAuthenticated() && isAdminOrPusat();
    }

    match /user_profiles/{userId} {
      allow read: if isAdminOrPusat() || request.auth.uid == userId;
      allow write: if false; // Diubah melalui Cloud Functions
    }

    // Operasional Inventaris & Mutasi Stok
    match /branch_inventories/{doc} {
      allow read: if isAdminOrPusat() || (isStaffBranch() && isBranchContext(resource.data.branchId));
      allow create: if isAdminOrPusat() || (isStaffBranch() && isBranchContext(request.resource.data.branchId));
      allow update: if isAdminOrPusat() || (isStaffBranch() && isBranchContext(resource.data.branchId) && isBranchContext(request.resource.data.branchId));
      allow delete: if isAdminOrPusat();
    }

    match /stock_transfers/{doc} {
      allow read: if isAdminOrPusat() || (isStaffBranch() && (isBranchContext(resource.data.targetBranchId) || isBranchContext(resource.data.to_branch_id)));
      // Hanya pusat yang bisa kirim, cabang hanya bisa update status penerimaan
      allow create: if isAdminOrPusat();
      allow update: if isAdminOrPusat();
      allow delete: if isAdminOrPusat();
    }

    match /stock_requests/{doc} {
      allow read: if isAuthenticated();
      // Cabang hanya boleh request untuk cabangnya sendiri
      allow create: if isStaffBranch() && isBranchContext(request.resource.data.branchId);
      allow update: if isAdminOrPusat();
      allow delete: if isAdminOrPusat();
    }

    match /stock_movements/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrPusat() || (isStaffBranch() && isBranchContext(request.resource.data.branchId));
      allow update, delete: if isAdminOrPusat();
    }

    match /notifications/{doc} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.get('message', '').size() <= 1000 && request.resource.data.get('title', '').size() <= 150;
      allow update: if isAuthenticated(); // To mark as read
      allow delete: if isAdminOrPusat();
    }

    // Koleksi Sensitif Terkunci (Zero-Trust: Hanya bisa dimodifikasi via Cloud Functions / Admin SDK)
    match /branch_stocks/{doc} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /sales_transactions/{doc} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /invoices/{doc} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /credit_limit_audit_logs/{doc} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Default Deny: Tolak seluruh akses unauthenticated / unhandled
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
